{
  "swagger": "2.0",
  "info": {
    "description": "Tech X mail Note you can't send a text and html. pick one",
    "version": "1.0.0",
    "title": "Tech x Mail",
    "contact": {
      "email": "paulambrose5002@gmail.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "schemes": ["http", "https"],
  "host": "localhost:3000",
  "basePath": "/",
  "paths": {
    "/sendmail": {
      "post": {
        "summary": "Send mail ",
        "description": "Send mail . containing any details",
        "produces": ["application/json"],
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "formData",
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Sender name"
          },
          {
            "in": "formData",
            "name": "mail",
                  "type": "string",
            "required": true,
            "description": "Recipient email address"
                },
          {
            "in": "formData",
            "name": "subject",
                  "type": "string",
            "required": true,
            "description": "Email subject"
                },
          {
            "in": "formData",
            "name": "text",
                  "type": "string",
            "required": false,
            "description": "Plain text content (optional if html is provided)"
                },
          {
            "in": "formData",
            "name": "html",
                  "type": "string",
            "required": false,
            "description": "HTML content (optional if text is provided)"
                },
          {
            "in": "formData",
            "name": "attachments",
            "type": "file",
            "required": false,
            "description": "File attachments (PDF, TXT, DOC, DOCX, JPG, PNG - max 5MB each)",
            "allowMultiple": true
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/success"
            }
          },
          "400": {
            "description": "Invalid status value",
            "schema": {
              "$ref": "#/definitions/InvalidResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "success": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "value": "Email sent successfully"
        },

        "status": {
          "type": "number",
          "value": 200
        }
      }
    },
    "InvalidResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "number",
          "value": "400"
        },
        "message": {
          "type": "string",
          "value": "incomplete data"
        }
      }
    }
  }
}
